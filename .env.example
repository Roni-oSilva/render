# ===== Executor (GitHub Actions: configure como SECRETS do repositório) =====
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # NUNCA no frontend
# Alertas (todos opcionais; configure ao menos um)
DISCORD_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=
RESEND_API_KEY=                       # e-mail via Resend
ALERT_EMAIL_FROM=                     # ex.: Guardian <alertas@seudominio.com>
ALERT_EMAIL_TO=
# Supervisão independente (dead-man's switch, ex.: healthchecks.io)
HEARTBEAT_URL=
# Opcional
MAX_CONCURRENCY=5

# ===== Painel (GitHub Actions: configure como VARIABLES; valores públicos) =====
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=               # chave anon/publishable (protegida por RLS)
